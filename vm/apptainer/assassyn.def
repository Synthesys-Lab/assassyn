Bootstrap: localimage
From: /tmp/repo.sif

%post
    /bin/zsh << ZSHEOF
cd /app

source setup.sh
make all

# Activate the virtual environment for subsequent operations
source /app/.assassyn-venv/bin/activate

cat >> \$APPTAINER_ENVIRONMENT <<EOF
export RUSTC_WRAPPER="\$RUSTC_WRAPPER"
export ASSASSYN_HOME="\$ASSASSYN_HOME"
export VERILATOR_ROOT="\$VERILATOR_ROOT"
export PYTHONPATH="\$PYTHONPATH"
export CC="ccache gcc"
export CXX="ccache g++"
export CCACHE_DIR="/tmp/ccache"
export CARGO_HOME="/tmp/cargo"
export VIRTUAL_ENV="/app/.assassyn-venv"
export PATH="/app/.assassyn-venv/bin:\$PATH"
EOF
ZSHEOF

%runscript
    exec "\$@"

%test
    #!/bin/zsh
    echo "=== Testing builds ==="
    cd /app
    python -c 'import assassyn' # import this module
    echo $? # 0 is expected
