Bootstrap: localimage
From: assassyn-base.sif

%post
    # Copy the current repository snapshot to /app
    cp -r /workspace /app
    cd /app
    
    # Remove unnecessary directories to reduce image size
    rm -rf examples/ docs/ tutorials/
    
    # Build the project from the repository snapshot
    export PYTHONUSERBASE="/app/.local"
    source setup.sh
    make build-all
    
    # Set up environment
    PYTHON_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    PYTHONPATH="$PYTHONPATH:/app/.local/lib/python${PYTHON_VERSION}/site-packages"
    PATH="$PATH:/app/.local/bin"
    
    cat >> $APPTAINER_ENVIRONMENT <<EOF
export ASSASSYN_HOME="$ASSASSYN_HOME"
export VERILATOR_ROOT="$VERILATOR_ROOT"
export PYTHONPATH="$PYTHONPATH"
export PATH="$PATH"
export CC="ccache gcc"
export CXX="ccache g++"
export CCACHE_DIR="/tmp/ccache"
export PYTHONUSERBASE="/app/.local"
export CARGO_HOME="/tmp/cargo"
EOF

%runscript
    exec "$@"

%test
    #!/bin/zsh
    echo "=== Testing repository snapshot build ==="
    cd /app
    python -c 'import assassyn' # import this module
    echo "Import test: $?"
    
    # Run basic tests if available
    if [ -f "Makefile" ] && grep -q "test" Makefile; then
        make test-all
        echo "Test suite: $?"
    fi
